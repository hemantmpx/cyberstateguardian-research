# Copy to .env for local development and replace placeholders before lab use.
APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_DB=cyberstateguardian
POSTGRES_USER=csg
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://csg:change-me-for-local-lab@postgres:5432/cyberstateguardian

CSG_API_HOST=0.0.0.0
CSG_API_PORT=8000
CSG_LAB_SHARED_TOKEN=

# Final research mode: native Windows probe is authoritative state; Wazuh supplies events.
CSG_STATE_PROVIDER=probe
CSG_EVENT_PROVIDER=wazuh
CSG_STATE_FIXTURE_NAME=baseline
CSG_EVENT_FIXTURE_SET=all
CSG_OBSERVATION_WINDOW_SECONDS=900
CSG_TRANSITION_CAPTURE_ENABLED=false
CSG_TRANSITION_PROCESSES_ENABLED=false
CSG_TRANSITION_SERVICES_ENABLED=false
CSG_TRANSITION_REGISTRY_ENABLED=false
CSG_TRANSITION_TASKS_ENABLED=false
CSG_TRANSITION_PRIVILEGED_GROUPS_ENABLED=false
CSG_TRANSITION_LISTENERS_ENABLED=false
CSG_TRANSITION_POLL_INTERVAL_SECONDS=5
CSG_TRANSITION_SPOOL_PATH=C:\ProgramData\CyberStateGuardian\transition-spool.jsonl
CSG_TRANSITION_SPOOL_MAX_BYTES=104857600
# Optional process filters are JSON arrays of case-insensitive wildcard patterns.
# When set, the active patterns are recorded in process monitor health metrics.
# CSG_TRANSITION_PROCESS_INCLUDE_PATTERNS=["*powershell*","*research*"]
# CSG_TRANSITION_PROCESS_EXCLUDE_PATTERNS=["*windows defender*"]
# Leave unset to derive /api/probe/transitions from CSG_PROBE_API_URL.
# CSG_TRANSITION_API_URL=http://127.0.0.1:8000/api/probe/transitions
CSG_EVENT_TIME_TOLERANCE_SECONDS=20
CSG_RECONCILIATION_GRACE_SECONDS=60
CSG_PIPELINE_ON_INGEST=true
CSG_WORKER_INTERVAL_SECONDS=30
CSG_WORKER_BATCH_SIZE=100
CSG_LIVE_FINDING_CATEGORIES=service,listener,scheduled_task,privileged_group,registry
CSG_INCIDENT_CORRELATION_WINDOW_SECONDS=3600
CSG_INCIDENT_TEMPORAL_ONLY_WINDOW_SECONDS=900
CSG_INCIDENT_CORRELATION_MIN_SCORE=40

# Wazuh live-lab provider. Use host.docker.internal when CSG runs in Docker and Wazuh runs
# through scripts/setup_wazuh_lab.py on the same Mac.
CSG_WAZUH_API_URL=https://host.docker.internal:55000
CSG_WAZUH_INDEXER_URL=https://host.docker.internal:9200
CSG_WAZUH_DASHBOARD_URL=https://localhost:8443
CSG_WAZUH_API_USER=wazuh
CSG_WAZUH_API_PASSWORD=
CSG_WAZUH_INDEXER_USER=admin
CSG_WAZUH_INDEXER_PASSWORD=
CSG_WAZUH_VERIFY_SSL=false
CSG_WAZUH_ALERT_INDEX_PATTERN=wazuh-alerts-*
CSG_WAZUH_ARCHIVE_INDEX_PATTERN=
CSG_WAZUH_INVENTORY_INDEX_PREFIX=wazuh-states-inventory
CSG_WAZUH_INVENTORY_LIMIT=5000
CSG_WAZUH_EVENT_LIMIT=5000
CSG_WAZUH_REQUEST_TIMEOUT_SECONDS=20
CSG_WAZUH_SYNC_ENABLED=false
CSG_WAZUH_SYNC_HOST_IDS=
# Bounded rolling query; keep it aligned with the 15-minute CSG observation horizon.
CSG_WAZUH_EVENT_LOOKBACK_SECONDS=900
CSG_STATE_CROSS_VALIDATION_ENABLED=true

CSG_AUTHORIZED_STATE_PATH=config/authorized-state.example.yaml
CSG_RISK_RULES_PATH=config/risk-rules.yaml
CSG_PROVIDERS_CONFIG_PATH=config/providers.example.yaml

CSG_AI_ENABLED=false
CSG_AI_PROVIDER=ollama
OPENAI_API_KEY=
CSG_OPENAI_MODEL=gpt-5-mini
CSG_OLLAMA_BASE_URL=http://host.docker.internal:11434
CSG_OLLAMA_MODEL=llama3.1:8b
CSG_OLLAMA_TIMEOUT_SECONDS=180
CSG_OLLAMA_NUM_PREDICT=2600
CSG_OLLAMA_NUM_CTX=16384
CSG_AI_CONTEXT_WINDOW_SECONDS=900
CSG_AI_CONTEXT_MAX_EVENTS=100
CSG_AI_CONTEXT_RELATED_LIMIT=25
CSG_AI_CONTEXT_EXPANSION_WINDOWS=900,3600,21600,86400
CSG_AI_CONTEXT_MIN_RELEVANT_EVENTS=3
# Keep security telemetry out of OpenAI response storage by default.
CSG_AI_STORE_RESPONSES=false

CSG_DASHBOARD_API_BASE_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_TELEMETRY_DISABLED=1
CSG_WEB_PORT=3001
