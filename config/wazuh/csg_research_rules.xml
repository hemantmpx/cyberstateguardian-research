<group name="windows,sysmon,registry_event,">
  <rule id="100510" level="5">
    <if_sid>61615</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\+software\\+microsoft\\+windows\\+currentversion\\+run\\+</field>
    <field name="win.eventdata.eventType" type="pcre2">^SetValue$</field>
    <description>Sysmon: autorun Run-key value modified</description>
    <group>sysmon_event_13,registry_event,</group>
  </rule>
</group>
